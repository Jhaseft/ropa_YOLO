# Copia este archivo como .env y completa los valores.
# NUNCA subas el archivo .env real al repositorio (está en .gitignore).

# Private API Key de Roboflow (Settings -> API Keys en app.roboflow.com).
# Usa la clave privada, NO la publishable (las que empiezan con "rf_").
ROBOFLOW_API_KEY=

# Workspace propio (ej. jhasefts-workspace) o el del autor original (ej. sem7-project)
ROBOFLOW_WORKSPACE=

# Slug del proyecto. Sale de la URL:
# app.roboflow.com/<WORKSPACE>/<PROJECT>/<VERSION>
ROBOFLOW_PROJECT=

# Número de versión del dataset en Roboflow
ROBOFLOW_VERSION=1
